<div
  class="fairdrop-entry-block"
  data-fairdrop-widget
  data-widget-url="/apps/fairdrop/raffles"
  data-entry-url-base="/apps/fairdrop/raffles"
  data-login-url="{{ routes.account_login_url }}&amp;return_url={{ request.path | url_encode }}"
  {% if customer %}
    data-customer-name="{{ customer.name | escape }}"
    data-customer-email="{{ customer.email | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <h2 class="fairdrop-entry-block__heading">{{ block.settings.heading | escape }}</h2>
  <div class="fairdrop-entry-block__content" aria-live="polite" aria-atomic="true">
    <p class="fairdrop-entry-block__status">Loading raffle details…</p>
  </div>
</div>

{% schema %}
{
  "name": "Fairdrop raffle entry",
  "target": "section",
  "stylesheet": "raffle-entry.css",
  "javascript": "raffle-entry.min.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Enter the raffle"
    }
  ]
}
{% endschema %}
