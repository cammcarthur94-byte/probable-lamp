SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=read_customers,read_draft_orders,read_orders,read_products,read_publications,write_app_proxy,write_draft_orders,write_orders,write_publications
DATABASE_URL=postgresql://user:password@localhost:5432/fairdrop

# Winner email delivery through Resend (required to draw winners)
RESEND_API_KEY=
MAIL_FROM=Fairdrop <raffles@your-domain.example>

# Required by the scheduled expiry endpoint (POST /api/expire-winners)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional when Shopify app URL is not the directly reachable public endpoint.
QSTASH_ENDPOINT_URL=
